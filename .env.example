# DocuChat environment — copy to .env.local and fill in your own values.

# OpenAI API key (embeddings + chat). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase project (create free at https://supabase.com, then run
# supabase/migrations/001_init.sql in the SQL editor)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY, never expose to the browser.
# Supabase dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=
